{
  "_comment_sdktype": "本项目只支持 hcnetsdk：直接登录 NVR 并实时预览或按时间回放",
  "sdktype": "hcnetsdk",
  "server": { "bind": "127.0.0.1", "port": 28080, "threads": 8, "maxSessions": 8 },
  "sdk": {
    "directory": "./sdk/bin",
    "hcnetDirectory": "./hcnetsdk",
    "readVideoCodecFromDevice": true,
    "forceKeyFrameOnRealPlay": true,
    "realPlayKeyFrameIntervalFrames": 25,
    "connectProbeTimeoutMs": 1500
  },
  "ffmpeg": {
    "path": "./ffmpeg/ffmpeg.exe",
    "logLevel": "info",
    "hardwareAcceleration": "auto",
    "hardwareProbeTimeoutMs": 3000
  },
  "media": {
    "queueBytes": 67108864,
    "queueBackpressureMs": 500,
    "outputVideoCodec": "h264",
    "videoEncoder": "libx264",
    "videoPreset": "veryfast",
    "enableAudio": false,
    "codecCacheSeconds": 900,
    "codecCacheFile": "./state/video-codec-cache.json",
    "disableAudioWhenSpeedChanged": true,
    "maxPlaybackSeconds": 86400
  },
  "timeouts": { "resolveUrlMs": 5000, "sdkStartMs": 10000, "firstMediaMs": 15000, "noSdkDataMs": 10000, "playbackKeepAliveMs": 1500, "httpWriteMs": 10000, "stopMs": 5000 },
  "logging": { "directory": "./logs", "level": "info", "retentionDays": 30 },
  "development": { "allowDirectSourceUrl": false }
}
