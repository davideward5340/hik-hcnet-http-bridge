{
  "sdktype": "hcnetsdk",
  "server": {
    "bind": "127.0.0.1",
    "port": 28080,
    "maxSessions": 16,
    "maxHttpConnections": 64
  },
  "sdk": {
    "directory": "./hcnetsdk",
    "readVideoCodecFromDevice": true,
    "forceKeyFrameOnRealPlay": true,
    "realPlayKeyFrameIntervalFrames": 25,
    "connectProbeTimeoutMs": 1500
  },
  "ffmpeg": {
    "path": "./ffmpeg/ffmpeg.exe",
    "logLevel": "info",
    "hardwareAcceleration": "auto",
    "hardwareProbeTimeoutMs": 3000
  },
  "logging": {
    "directory": "./logs",
    "retentionDays": 30
  },
  "media": {
    "queueBytes": 67108864,
    "queueBackpressureMs": 500,
    "maxPlaybackSeconds": 86400,
    "outputVideoCodec": "h264",
    "videoEncoder": "libx264",
    "videoPreset": "veryfast",
    "enableAudio": false,
    "codecCacheSeconds": 900,
    "codecCacheFile": "./state/video-codec-cache.tsv"
  },
  "timeouts": {
    "sdkStartMs": 10000,
    "firstMediaMs": 15000,
    "noSdkDataMs": 10000,
    "outputStallMs": 60000,
    "clientWriteStallMs": 60000,
    "playbackKeepAliveMs": 1500
  }
}
