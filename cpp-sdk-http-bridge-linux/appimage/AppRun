#!/usr/bin/env sh
# AppImage 入口。可由 AppImage Runtime 调用，也可在解压后的 AppDir 内直接执行。
set -eu

if command -v locale >/dev/null 2>&1 && locale -a 2>/dev/null | grep -Eiq '^C([.]UTF-?8|[.]utf8)$'; then
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
fi

APP_HOME=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)}
BIN="$APP_HOME/usr/bin/hik-sdk-http-bridge"
SDK_DIR="$APP_HOME/usr/lib/hik/sdk"
COMPONENT_DIR="$SDK_DIR/HCNetSDKCom"
FFMPEG="$APP_HOME/usr/lib/hik/runtime/ffmpeg/ffmpeg"
DEFAULT_CONFIG="$APP_HOME/usr/share/hik/config/config.json"
MANIFEST="$APP_HOME/usr/share/hik/release-manifest.env"

fail() {
    printf '%s\n' "错误：$*" >&2
    exit 1
}

version_at_least() {
    [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" = "$2" ]
}

package_arch=
if [ -r "$MANIFEST" ]; then
    package_arch=$(sed -n 's/^ARCH=//p' "$MANIFEST" | head -n 1 || true)
fi
[ -n "$package_arch" ] || package_arch=x86_64
[ "$(uname -m)" = "$package_arch" ] || fail "本 AppImage 需要 $package_arch，当前架构为 $(uname -m)。"
[ -x "$BIN" ] || fail "AppImage 内缺少桥接程序。"
[ -x "$FFMPEG" ] || fail "AppImage 内缺少静态 FFmpeg。"
[ -r "$SDK_DIR/libhcnetsdk.so" ] || fail "AppImage 内缺少 HCNetSDK。"
[ -d "$COMPONENT_DIR" ] || fail "AppImage 内缺少 HCNetSDKCom 组件目录。"

required_glibc=2.28
if [ -r "$MANIFEST" ]; then
    manifest_glibc=$(sed -n 's/^REQUIRED_GLIBC=//p' "$MANIFEST" | head -n 1 || true)
    [ -z "$manifest_glibc" ] || required_glibc=$manifest_glibc
fi
glibc_line=$(getconf GNU_LIBC_VERSION 2>/dev/null || true)
case "$glibc_line" in
    glibc\ *) host_glibc=${glibc_line#glibc } ;;
    *) fail "未检测到 glibc；本 AppImage 不支持 musl/Alpine Linux。" ;;
esac
version_at_least "$host_glibc" "$required_glibc" || fail "当前 glibc 为 $host_glibc，至少需要 $required_glibc。"

export LD_LIBRARY_PATH="$SDK_DIR:$COMPONENT_DIR:$APP_HOME/usr/lib/hik/runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export HIK_BRIDGE_SDK_DIR="$SDK_DIR"
export HIK_BRIDGE_FFMPEG_PATH="$FFMPEG"
export HIK_BRIDGE_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hik-sdk-http-bridge/logs"
mkdir -p "$HIK_BRIDGE_LOG_DIR"

if [ "${1:-}" = "--version" ]; then
    exec "$BIN" --version
fi
if [ "${1:-}" = "--config" ]; then
    [ "$#" -ge 2 ] || fail "--config 后必须提供配置文件路径。"
    exec "$BIN" "$@"
fi

CONFIG=${HIK_BRIDGE_CONFIG:-$DEFAULT_CONFIG}
if [ -n "${HIK_BRIDGE_LOG_FILE:-}" ]; then
    exec "$BIN" --config "$CONFIG" "$@" >> "$HIK_BRIDGE_LOG_FILE" 2>&1
fi
exec "$BIN" --config "$CONFIG" "$@"
